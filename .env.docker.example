COMPOSE_PROJECT_NAME=smart-bike

# Port host untuk Nginx container. Cloudflare Tunnel bisa diarahkan ke http://localhost:8005
WEB_PORT=8005

# Database MariaDB container
DB_DATABASE=smart_bike_rental
DB_USERNAME=smart_bike
DB_PASSWORD=change_this_strong_password
MYSQL_ROOT_PASSWORD=change_this_root_password
DB_PORT_EXTERNAL=3311

# Sesuaikan dengan user Linux server jika perlu.
HOST_UID=1000
HOST_GID=1000

# Set true hanya saat ingin seed data demo/default dari DatabaseSeeder.
RUN_SEED_ON_DEPLOY=false

# Opsional jika ingin menjalankan Cloudflare Tunnel via Docker Compose profile.
CLOUDFLARE_TUNNEL_TOKEN=

